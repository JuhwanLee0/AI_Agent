# ==============================================================================
# 🔑 Google Gemini API Keys (1, 2, 3 분할 관리)
# ==============================================================================
# [Key 1] CEO (최고경영자 전용 키)
GEMINI_API_KEY_1=

# [Key 2] 팀장 & 개발직원 (모든 팀장 + 개발_사원A~E 전용 키)
GEMINI_API_KEY_2=

# [Key 3] 마케팅 & SNS 실무 사원 (대본 초안/리서치 전용 키)
GEMINI_API_KEY_3=

# [공통 폴백] 공통 Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# 🤖 Google Gemini 모델 버전 설정 (CEO: 3.6, 팀장/개발직원: 3.6, 마케팅/SNS: 3.6)
# ==============================================================================
MODEL_CEO=3.6
MODEL_MANAGER=3.6
MODEL_WORKER=3.6

# ==============================================================================
# 🛡️ API 쿼터 쉴드 & CEO 키 스마트 차용 (CEO 20% 안전 비축분 보존)
# ==============================================================================
ENABLE_CEO_KEY_FALLBACK=true
CEO_KEY_MAX_BORROW_PERCENT=80
DAILY_CEO_KEY_LIMIT=20
DEFAULT_DAILY_CONTENT_COUNT=3

# ==============================================================================
# 🔍 검색 & 웹 리서치 API Keys
# ==============================================================================
TAVILY_API_KEY=
JINA_API_KEY=

# ==============================================================================
# 📱 Meta Threads API (최종 승인 시 자동 발행)
# ==============================================================================
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ==============================================================================
# 💬 Slack App Tokens (Socket Mode) & 5대 전용 운영 채널
# ==============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-level-token

# [채널 1] #hq-board (CEO + 팀장들 + 나: 최종 의사결정 및 승인 태그용)
SLACK_CHANNEL_HQ=C0123456789

# [채널 2] #ceo-briefing (CEO -> 사용자 다이렉트 일일 보고)
SLACK_CHANNEL_CEO_REPORT=C0123456781

# [채널 3] #output-review (Output 검수: 카드뉴스/스레드 팩트체크 검수 및 승인)
SLACK_CHANNEL_OUTPUT_REVIEW=C0123456782

# [채널 4] #team-dev (개발팀장 + 개발_사원A~E 실무)
SLACK_CHANNEL_DEV=C0123456783

# [채널 5] #team-marketing (마케팅/미디어 팀장 + 실무사원)
SLACK_CHANNEL_MARKETING=C0123456784
