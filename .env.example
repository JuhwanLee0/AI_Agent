# ==============================================================================
# 🔑 무료 AI Cloud API Keys (Cerebras & Groq 듀얼 클라우드 - 단 2개)
# ==============================================================================
# 1. Cerebras Cloud API Key (131K 초장문 컨텍스트 & 일일 300만 토큰)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# 2. Groq Cloud API Key (초고속 30 RPM & Qwen/Llama/120B 실시간 추론)
GROQ_API_KEY=your_groq_api_key_here


# ==============================================================================
# 🤖 AI 모델 버전 설정 (초고속 무제한 Groq & Cerebras 듀얼 클라우드)
# ==============================================================================
# 1. CEO용 모델 (Qwen 27B 초고지능 & 20B 듀얼 구성)
MODEL_CEO=groq/qwen/qwen3.6-27b
MODEL_CEO_SUB=groq/openai/gpt-oss-20b

# 2. 팀장 & 개발직원용 모델 (고난도 풀스택 코딩 & 아키텍처)
MODEL_MANAGER=groq/qwen/qwen3.6-27b
MODEL_MANAGER_SUB=groq/openai/gpt-oss-20b

# 3. 마케팅 & SNS 실무 사원용 모델 (20B 초고속 카피라이팅)
MODEL_WORKER=groq/openai/gpt-oss-20b
MODEL_WORKER_SUB=groq/qwen/qwen3.6-27b

# 4. 프롬프트 가드레일 & 보안 필터링 전용 경량 모델
MODEL_GUARD=groq/meta-llama/llama-prompt-guard-2-86m


# ==============================================================================
# 🛡️ 듀얼 API 쿼터 쉴드 & 스마트 차용 / 폴백 설정
# ==============================================================================
# 실무사원이 한도(429) 초과 시 CEO 키 및 타 클라우드 자동 폴백 허용 여부
ENABLE_CEO_KEY_FALLBACK=true

# CEO 키 최대 차용 비율 (80%까지만 실무사원에게 대여, 20%는 CEO 전용 무조건 보존)
CEO_KEY_MAX_BORROW_PERCENT=80

# Cerebras 일일 총 한도 기준 (RPD 2,400회 / TPD 3,000,000 토큰)
DAILY_CEREBRAS_LIMIT=2400

# Groq 일일 총 한도 기준 (120b/20b/qwen: RPD 1,000회 / compound: RPD 250회)
DAILY_GROQ_LIMIT=1000

# 하루 기본 생성 콘텐츠 수량 (안전 웜업 기본 3개 권장)
DEFAULT_DAILY_CONTENT_COUNT=3


# ==============================================================================
# 🔍 검색 & 웹 리서치 API Keys (선택 사항)
# ==============================================================================
TAVILY_API_KEY=
JINA_API_KEY=


# ==============================================================================
# 📱 Meta Threads API (최종 승인 시 자동 발행 / 선택 사항)
# ==============================================================================
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=


# ==============================================================================
# 💬 Slack App Tokens (Socket Mode) & 5대 전용 운영 채널
# ==============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_APP_TOKEN=xapp-your-slack-app-level-token

# [채널 1] #hq-board (CEO + 팀장들 + 나: 최종 의사결정 및 승인 태그용)
SLACK_CHANNEL_HQ=C0123456789

# [채널 2] #ceo-briefing (CEO -> 사용자 다이렉트 일일 보고)
SLACK_CHANNEL_CEO_REPORT=C0123456781

# [채널 3] #output-review (Output 검수: 카드뉴스/스레드 팩트체크 검수 및 승인)
SLACK_CHANNEL_OUTPUT_REVIEW=C0123456782

# [채널 4] #team-dev (개발팀장 + 개발_사원A~E 실무)
SLACK_CHANNEL_DEV=C0123456783

# [채널 5] #team-marketing (마케팅/미디어 팀장 + 실무사원)
SLACK_CHANNEL_MARKETING=C0123456784
